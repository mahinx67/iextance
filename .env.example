# Public URL of the deployed service, without a trailing slash.
APP_URL="https://your-app.onrender.com"

# Telegram Bot Storage Config. Required for cloud image links.
TELEGRAM_BOT_TOKEN="replace-with-your-telegram-bot-token"
TELEGRAM_CHAT_ID="replace-with-your-telegram-chat-id"

# Admin source-download protection. Use long random values in production.
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
ADMIN_SESSION_SECRET="replace-with-a-long-random-signing-secret"
