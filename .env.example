# Public URL of the deployed service, without a trailing slash.
APP_URL="https://your-app.onrender.com"

# Frontend/developer portal origins, comma-separated.
FRONTEND_URL="https://your-site.netlify.app,https://your-developer-portal.netlify.app"

# Developer API signing secret. Required for stable API keys across restarts.
API_KEY_SECRET="replace-with-a-long-random-api-signing-secret"
MAX_API_FILE_BYTES="10485760"

# Telegram Bot Storage Config. Required for cloud image links.
TELEGRAM_BOT_TOKEN="replace-with-your-telegram-bot-token"
TELEGRAM_CHAT_ID="replace-with-your-telegram-chat-id"

# Admin source-download protection. Use long random values in production.
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
ADMIN_SESSION_SECRET="replace-with-a-long-random-signing-secret"
